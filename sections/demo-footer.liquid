{%- liquid
  assign footer_logo = section.settings.logo
  assign product_menu = section.settings.product_menu
  assign bottom_menu = section.settings.bottom_menu
  assign button_url = section.settings.button_url
  assign demo_items = section.settings.demo_items | newline_to_br | split: '<br />'

  if button_url == blank
    assign button_url = 'https://apps.shopify.com/product-filter-and-search'
  endif
-%}

<footer
  class="demo-store-footer"
  style="
    --demo-footer-width: {{ section.settings.page_width }}px;
    --demo-footer-background: {{ section.settings.background_color }};
    --demo-footer-text: {{ section.settings.text_color }};
    --demo-footer-muted: {{ section.settings.muted_color }};
    --demo-footer-border: {{ section.settings.border_color }};
    --demo-footer-button-background: {{ section.settings.button_background }};
    --demo-footer-button-text: {{ section.settings.button_text_color }};
    --demo-footer-padding-top: {{ section.settings.padding_top }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="demo-store-footer__top">
    <div class="demo-store-footer__brand">
      <div class="demo-store-footer__brand-heading">
        {%- if footer_logo != blank -%}
          {{-
            footer_logo
            | image_url: width: 96
            | image_tag:
              class: 'demo-store-footer__logo',
              widths: '34, 68, 96',
              width: 34,
              loading: 'lazy',
              alt: section.settings.brand_title
          -}}
        {%- else -%}
          <img
            class="demo-store-footer__logo"
            src="{{ 'app_icon.webp' | asset_url }}"
            width="34"
            height="34"
            loading="lazy"
            alt=""
          >
        {%- endif -%}

        {%- if section.settings.brand_title != blank -%}
          <span class="demo-store-footer__title">{{ section.settings.brand_title | escape }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.description != blank -%}
        <div class="demo-store-footer__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_status and section.settings.status_text != blank -%}
        <div class="demo-store-footer__status">
          <span class="demo-store-footer__status-dot" aria-hidden="true"></span>
          <span>{{ section.settings.status_text | escape }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="demo-store-footer__column">
      {%- if section.settings.product_heading != blank -%}
        <h2 class="demo-store-footer__heading">{{ section.settings.product_heading | escape }}</h2>
      {%- endif -%}

      {%- if product_menu != blank -%}
        {%- for link in product_menu.links -%}
          <a class="demo-store-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' and block.settings.label != blank and block.settings.url != blank -%}
            <a
              class="demo-store-footer__link"
              href="{{ block.settings.url }}"
              {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="demo-store-footer__column">
      {%- if section.settings.demo_heading != blank -%}
        <h2 class="demo-store-footer__heading">{{ section.settings.demo_heading | escape }}</h2>
      {%- endif -%}

      {%- for item in demo_items -%}
        {%- assign item_text = item | strip -%}
        {%- if item_text != blank -%}
          <span class="demo-store-footer__text">{{ item_text | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="demo-store-footer__column demo-store-footer__column--cta">
      {%- if section.settings.cta_heading != blank -%}
        <h2 class="demo-store-footer__heading">{{ section.settings.cta_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <div class="demo-store-footer__description rte">{{ section.settings.cta_text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="demo-store-footer__button"
          href="{{ button_url }}"
          {% if section.settings.open_button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="demo-store-footer__bottom">
    {%- if section.settings.copyright != blank -%}
      <div class="demo-store-footer__copyright">{{ section.settings.copyright }}</div>
    {%- endif -%}

    <nav class="demo-store-footer__bottom-links" aria-label="Footer">
      {%- if bottom_menu != blank -%}
        {%- for link in bottom_menu.links -%}
          <a class="demo-store-footer__bottom-link" href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bottom_link' and block.settings.label != blank and block.settings.url != blank -%}
            <a
              class="demo-store-footer__bottom-link"
              href="{{ block.settings.url }}"
              {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>
  </div>
</footer>

{% stylesheet %}
  .demo-store-footer {
    width: 100%;
    padding: var(--demo-footer-padding-top) 40px 0;
    color: var(--demo-footer-text);
    background: var(--demo-footer-background);
  }

  .demo-store-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    gap: 48px 40px;
    width: 100%;
    max-width: var(--demo-footer-width);
    margin-inline: auto;
    padding-bottom: 56px;
  }
  .demo-store-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 340px;
  }

  .demo-store-footer__brand-heading {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .demo-store-footer__logo {
    display: block;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    object-fit: cover;
    border-radius: 8px;
  }

  .demo-store-footer__title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -.01em;
  }

  .demo-store-footer__description,
  .demo-store-footer__description p {
    margin: 0;
    color: var(--demo-footer-muted);
    font-size: 15px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .demo-store-footer__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
    color: var(--demo-footer-muted);
    font-size: 13.5px;
  }

  .demo-store-footer__status-dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    background: #4caf7d;
    border-radius: 50%;
  }

  .demo-store-footer__column {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .demo-store-footer__column--cta {
    gap: 16px;
    max-width: 280px;
  }

  .demo-store-footer__heading {
    margin: 0;
    color: var(--demo-footer-muted);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .demo-store-footer__link,
  .demo-store-footer__bottom-link {
    color: inherit;
    text-decoration: none;
    transition: color .18s ease, opacity .18s ease;
  }

  .demo-store-footer__link {
    font-size: 15px;
  }

  .demo-store-footer__link:hover,
  .demo-store-footer__bottom-link:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .demo-store-footer__text {
    color: var(--demo-footer-muted);
    font-size: 15px;
  }

  .demo-store-footer__button {
    align-self: flex-start;
    padding: 13px 24px;
    color: var(--demo-footer-button-text);
    background: var(--demo-footer-button-background);
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
    transition: opacity .18s ease, transform .18s ease;
  }

  .demo-store-footer__button:hover {
    opacity: .88;
    transform: translateY(-1px);
  }

  .demo-store-footer__button:focus-visible,
  .demo-store-footer__link:focus-visible,
  .demo-store-footer__bottom-link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .demo-store-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    width: 100%;
    max-width: var(--demo-footer-width);
    margin-inline: auto;
    padding: 24px 0 34px;
    border-top: 1px solid var(--demo-footer-border);
  }

  .demo-store-footer__copyright {
    color: var(--demo-footer-muted);
    font-size: 13.5px;
  }

  .demo-store-footer__copyright p {
    margin: 0;
  }

  .demo-store-footer__bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
  }

  .demo-store-footer__bottom-link {
    color: var(--demo-footer-muted);
    font-size: 13.5px;
  }

  @media screen and (max-width: 950px) {
    .demo-store-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    .demo-store-footer {
      padding: 48px 24px 0;
    }

    .demo-store-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
      padding-bottom: 36px;
    }

    .demo-store-footer__brand,
    .demo-store-footer__column--cta {
      grid-column: 1 / -1;
      max-width: none;
    }

    .demo-store-footer__brand {
      gap: 14px;
    }

    .demo-store-footer__title {
      font-size: 15px;
    }

    .demo-store-footer__description,
    .demo-store-footer__description p,
    .demo-store-footer__link,
    .demo-store-footer__text {
      font-size: 14px;
    }

    .demo-store-footer__column {
      gap: 12px;
    }

    .demo-store-footer__button {
      display: flex;
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .demo-store-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      padding-top: 22px;
      padding-bottom: 28px;
    }

    .demo-store-footer__bottom-links {
      gap: 10px 20px;
    }
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer {
    padding: 48px 24px 0;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__top {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
    padding-bottom: 36px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__brand,
  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__column--cta {
    grid-column: 1 / -1;
    max-width: none;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__brand {
    gap: 14px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__title {
    font-size: 15px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__description,
  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__description p,
  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__link,
  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__text {
    font-size: 14px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__column {
    gap: 12px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__button {
    display: flex;
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
    padding-top: 22px;
    padding-bottom: 28px;
  }

  .gpf-demo__storefront[mode='mobile'] .demo-store-footer__bottom-links {
    gap: 10px 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-store-footer__button,
    .demo-store-footer__link,
    .demo-store-footer__bottom-link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo footer",
  "tag": "section",
  "class": "demo-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "The app icon is used when no logo is selected."
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Title",
      "default": "Smart Product Filter & Search"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A stock Horizon theme running Smart Product Filter & Search. Every filter, swatch and suggestion on this page is served by the app — no theme code edits.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show status",
      "default": true
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status text",
      "default": "Sandbox data · resets nightly"
    },
    {
      "type": "header",
      "content": "Product links"
    },
    {
      "type": "text",
      "id": "product_heading",
      "label": "Heading",
      "default": "Product"
    },
    {
      "type": "link_list",
      "id": "product_menu",
      "label": "Menu source",
      "info": "The selected menu replaces the product link blocks."
    },
    {
      "type": "header",
      "content": "Demo features"
    },
    {
      "type": "text",
      "id": "demo_heading",
      "label": "Heading",
      "default": "In this demo"
    },
    {
      "type": "textarea",
      "id": "demo_items",
      "label": "Items",
      "info": "Enter one item per line.",
      "default": "Nested filter tree\nAI semantic search\nYear / Make / Model\nVariant swatches"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Try it on your store"
    },
    {
      "type": "richtext",
      "id": "cta_text",
      "label": "Text",
      "default": "<p>Install free, filter your own catalog in minutes.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Install the app"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "info": "The Globo app listing is used when no URL is selected."
    },
    {
      "type": "checkbox",
      "id": "open_button_new_tab",
      "label": "Open button in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "richtext",
      "id": "copyright",
      "label": "Copyright text",
      "default": "<p>© 2026 Globo.io · Demo storefront, not a real shop</p>"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu source",
      "info": "The selected menu replaces the bottom link blocks."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#e6e5e1"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#9a9a95"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#2a2a27"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#171717"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Product link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Product link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in a new tab",
          "default": true
        }
      ]
    },
    {
      "type": "bottom_link",
      "name": "Bottom link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Bottom link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in a new tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Demo footer",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "App listing",
            "url": "https://apps.shopify.com/product-filter-and-search",
            "open_new_tab": true
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "User guide",
            "url": "https://docs.globo.io/filter",
            "open_new_tab": true
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Pricing",
            "url": "https://globo.io/smart-product-filter-search#pricing-plans",
            "open_new_tab": true
          }
        },
        {
          "type": "bottom_link",
          "settings": {
            "label": "Privacy",
            "url": "https://globo.io/privacy",
            "open_new_tab": true
          }
        },
        {
          "type": "bottom_link",
          "settings": {
            "label": "Terms",
            "url": "https://globo.io/terms",
            "open_new_tab": true
          }
        },
        {
          "type": "bottom_link",
          "settings": {
            "label": "Support",
            "url": "https://globo.io/support",
            "open_new_tab": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
